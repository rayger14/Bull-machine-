{"nodes": [{"id": "docs_knowledge_industry_study_post_entry_alpha_2026_07_14_report", "label": "Industry Study Post-Entry Alpha", "file_type": "document", "source_file": "industry_study_post_entry_alpha_2026_07_14.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_knowledge_industry_study_post_entry_alpha_2026_07_14_meta_labeling", "label": "Meta-Labeling", "file_type": "concept", "source_file": "industry_study_post_entry_alpha_2026_07_14.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The #1 pro move: never retune the primary strategy \u2014 layer a secondary sizing model estimating P(win), fed features the primary doesn't use (post-entry behavior + regime state); size=0 subsumes filtering. Lopez de Prado AFML; Joubert JFDS 2022; Meyer/Barziy/Joubert 2023."}, {"id": "docs_knowledge_industry_study_post_entry_alpha_2026_07_14_mae_mfe_trade_management", "label": "MAE/MFE Trade Management", "file_type": "concept", "source_file": "industry_study_post_entry_alpha_2026_07_14.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sweeney 1996: winners and losers show statistically distinct post-entry excursion signatures \u2014 codify rules from your own excursion distributions; directly validates the path-conditional study."}, {"id": "docs_knowledge_industry_study_post_entry_alpha_2026_07_14_breadth_over_depth", "label": "Breadth Over Depth (IR = IC x sqrt N)", "file_type": "concept", "source_file": "industry_study_post_entry_alpha_2026_07_14.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At N=2 strategies, adding a third UNCORRELATED edge is the highest-marginal-value move \u2014 worth more than any tuning of the existing two."}, {"id": "docs_knowledge_industry_study_post_entry_alpha_2026_07_14_frozen_entries_discipline", "label": "Frozen-Entries Discipline", "file_type": "rationale", "source_file": "industry_study_post_entry_alpha_2026_07_14.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never retune entries on recent live losses: uncounted trials make any backtest worthless and the trial counter cannot be turned back (Bailey/Lopez de Prado); short live windows are mostly noise (TC-squared argument)."}], "edges": [{"source": "docs_knowledge_industry_study_post_entry_alpha_2026_07_14_report", "target": "docs_knowledge_industry_study_backtest_live_parity_2026_06_11_report", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "industry_study_post_entry_alpha_2026_07_14.md", "source_location": null, "weight": 1.0}, {"source": "docs_knowledge_industry_study_post_entry_alpha_2026_07_14_report", "target": "docs_knowledge_industry_study_post_entry_alpha_2026_07_14_meta_labeling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "industry_study_post_entry_alpha_2026_07_14.md", "source_location": null, "weight": 1.0}, {"source": "docs_knowledge_industry_study_post_entry_alpha_2026_07_14_report", "target": "docs_knowledge_industry_study_post_entry_alpha_2026_07_14_mae_mfe_trade_management", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "industry_study_post_entry_alpha_2026_07_14.md", "source_location": null, "weight": 1.0}, {"source": "docs_knowledge_industry_study_post_entry_alpha_2026_07_14_report", "target": "docs_knowledge_industry_study_post_entry_alpha_2026_07_14_breadth_over_depth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "industry_study_post_entry_alpha_2026_07_14.md", "source_location": null, "weight": 1.0}, {"source": "docs_knowledge_industry_study_post_entry_alpha_2026_07_14_report", "target": "docs
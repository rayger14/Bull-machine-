{"nodes": [{"id": "docs_knowledge_four_fixes_validation_2026_05_16_report", "label": "Four-Fix Validation", "file_type": "document", "source_file": "four_fixes_validation_2026_05_16.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_knowledge_four_fixes_validation_2026_05_16_tp_tier1_exit_defaults", "label": "TP Tier 1 Exit Defaults", "file_type": "concept", "source_file": "four_fixes_validation_2026_05_16.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only fix of four that improved OOS (+$8,784, +7.19%) without damage: trailing_atr_mult 2.5, trailing_start_r 1.0, scale_out_pcts [0.1,0.3,0.5] in exit_logic.py; CB and funding_divergence intentionally excluded; wick_trap the one casualty (-30%)."}, {"id": "docs_knowledge_four_fixes_validation_2026_05_16_cb_hard_gate_mode_rejection", "label": "CB gate_mode Hard Rejection", "file_type": "rationale", "source_file": "four_fixes_validation_2026_05_16.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flipping CB gate_mode soft->hard was catastrophic (OOS -$17,885, -14.63%; CB trades 345->74, lost $27K profit) \u2014 blocked trades were collectively profitable. Confirms Lesson #55; tighten individual thresholds instead of flipping the mode."}, {"id": "docs_knowledge_four_fixes_validation_2026_05_16_oi_divergence_direction_flip", "label": "oi_divergence Direction Flip Rejection", "file_type": "rationale", "source_file": "four_fixes_validation_2026_05_16.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simple long->short flip made the target archetype worse (-$1,511 -> -$3,173) because gates are direction-coupled (rsi<=35 becomes 'short the oversold bottom'); a full direction-aware gate rework (4-line change) is needed."}, {"id": "docs_knowledge_four_fixes_validation_2026_05_16_long_squeeze_ema_slope_gate", "label": "long_squeeze ema_slope Regime Gate Rejection", "file_type": "rationale", "source_file": "four_fixes_validation_2026_05_16.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ema_slope_50<=0 gate selected the worst trades (WR 50%->8.3%): rare long_squeeze wins happened during weak uptrends where slope was positive but slowing."}], "edges": [{"source": "docs_knowledge_four_fixes_validation_2026_05_16_report", "target": "docs_knowledge_four_fixes_validation_2026_05_16_tp_tier1_exit_defaults", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "four_fixes_validation_2026_05_16.md", "source_location": null, "weight": 1.0}, {"source": "docs_knowledge_four_fixes_validation_2026_05_16_report", "target": "docs_knowledge_four_fixes_validation_2026_05_16_cb_hard_gate_mode_rejection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "four_fixes_validation_2026_05_16.md", "source_location": null, "weight": 1.0}, {"source": "docs_knowledge_four_fixes_validation_2026_05_16_report", "target": "docs_knowledge_four_fixes_validation_2026_05_16_oi_divergence_direction_flip", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "four_fixes_validation_2026_05_16.md", "source_location": null, "weight": 1.0}, {"source": "docs_knowledge_four_fixes_validation_2026_05_16_report", "target": "docs_knowledge_four_fixes_validation_2026_05_16_long_squeeze_ema_slope_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "four_fixes_validation_2026_05_16.md", "source_location": null, "weight": 1.0}, {"source": "docs_knowledge_four_fixes_validation_2026_05_16_cb_hard_gate_mode_rejection", "target": "docs_knowledge_gate_enforcement_audit_2026_05_19_confluence_breakout", "relation": "conce
{"nodes": [{"id": "docs_knowledge_trailing_sweep_verdict_2026_07_13", "label": "Trailing-Start Sweep Rejected", "file_type": "document", "source_file": "trailing_sweep_verdict_2026_07_13.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_knowledge_trailing_sweep_verdict_2026_07_13_monotone_overfit_gradient", "label": "Monotone Overfit Gradient", "file_type": "concept", "source_file": "trailing_sweep_verdict_2026_07_13.md", "source_location": "Sweep results", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every step of earlier trailing protection improves train (1.37 to 1.76) and degrades the pristine holdout (1.43 to 0.96) \u2014 earlier protection clips winners that dip before running; in-sample clipped losses dominate, out-of-sample clipped winners do. Same signature as the wider-stops trap."}, {"id": "docs_knowledge_trailing_sweep_verdict_2026_07_13_exit_frontier_closed", "label": "Optimization Frontier Closed", "file_type": "concept", "source_file": "trailing_sweep_verdict_2026_07_13.md", "source_location": "bigger conclusion", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every evidence-motivated lever honestly tested against the holdout: entry filters 0/8, sizing 0/13, stop width, breakeven, level anchoring 0/3, edge-within 4x, regime skip, trailing start \u2014 wick_trap as configured is a local maximum in every direction; remaining information sources are live evidence, U3 watch item, V15 store rebuild, and new instruments."}, {"id": "docs_knowledge_trailing_sweep_verdict_2026_07_13_trailing_start_r_dead_config", "label": "trailing_start_r Dead YAML Config", "file_type": "concept", "source_file": "trailing_sweep_verdict_2026_07_13.md", "source_location": "Dead-config finding", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "YAML exit_logic.trailing_start_r is read into ArchetypeInstance metadata but never reaches ExitLogic rules \u2014 three YAML variants produced bit-identical backtests; the working override path is the user-JSON exit_logic.<archetype>.<param>."}, {"id": "docs_knowledge_risk_overlay_verdict_2026_06_27", "label": "Risk Overlay Verdict", "file_type": "document", "source_file": "trailing_sweep_verdict_2026_07_13.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_knowledge_trailing_sweep_verdict_2026_07_13", "target": "docs_knowledge_trailing_sweep_verdict_2026_07_13_monotone_overfit_gradient", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "trailing_sweep_verdict_2026_07_13.md", "source_location": null, "weight": 1.0}, {"source": "docs_knowledge_trailing_sweep_verdict_2026_07_13", "target": "docs_knowledge_trailing_sweep_verdict_2026_07_13_exit_frontier_closed", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "trailing_sweep_verdict_2026_07_13.md", "source_location": null, "weight": 1.0}, {"source": "docs_knowledge_trailing_sweep_verdict_2026_07_13", "target": "docs_knowledge_trailing_sweep_verdict_2026_07_13_trailing_start_r_dead_config", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "trailing_sweep_verdict_2026_07_13.md", "source_location": null, "weight": 1.0}, {"source": "docs_knowledge_trailing_sweep_verdict_2026_07_13", "target": "docs_knowledge_wick_trap_edge_within_2026_07_13", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "trailing_sweep_verdict_2026_07_13.md", "source_location": "Cross-references", "weight": 1.0}, {"source": "docs_knowledge_trailing_sweep_verdict_2026_07_13", "target": "docs_knowledge_unified_strategy_verdict_2026_07_13", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "trail